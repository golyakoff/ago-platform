<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.RateLimiting" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- `7-01`: PlatformObservabilityTests builds a real ServiceCollection/IConfiguration and
         resolves the OTel SDK's own TracerProvider to assert AddPlatformObservability's resource
         attributes, rather than asserting against Hosting's own private fields. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="OpenTelemetry" />
    <!-- `7-02`: ResiliencePolicyBuilderTests' breaker-state/bulkhead-rejection tests resolve the OTel
         SDK's own in-memory metric reader, the same bar PlatformObservabilityTests already holds
         tracing to. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ago.Platform.Kernel\Ago.Platform.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Ago.Platform.Hosting\Ago.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Ago.Platform.Resilience\Ago.Platform.Resilience.csproj" />
  </ItemGroup>

</Project>
