         must reference this package in order to exist at all - it holds IProductModule, the
         platform/product seam - so anything added here is added to every host of every shape,
         forever, whether or not that host can use it. The OpenTelemetry packages that used to sit
         below moved to Ago.Platform.Observability for exactly that reason (adr/0046); the arch test
         HostingPackagingTests keeps this list from growing back by accident. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ago.Platform.Kernel\Ago.Platform.Kernel.csproj" />
  </ItemGroup>

</Project>
