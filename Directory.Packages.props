<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Same reasoning as ago-chat's Directory.Packages.props: Integration.Tests only reaches EF
         Core transitively through Persistence.Postgres's ProjectReference, so without this the
         restore graph could pick Npgsql.EntityFrameworkCore.PostgreSQL's own transitive EFCore
         version instead of the pin below. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.11, not 10.0.0: EF Core 10.0.11 (Persistence label below) pulls both transitively at
         10.0.11 - same MSB3277/NU1109 conflict ago-chat's Directory.Packages.props already
         documents fixing. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- `7-01`: the concrete packages (not just the .Abstractions ones above), needed only by
         Ago.Platform.Tests to build a real ServiceCollection/IConfiguration against
         AddPlatformObservability - every production project still depends on the .Abstractions
         pair only, unchanged. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.11" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- Versions match ago-chat's own pins (Directory.Packages.props there) so a session working
         across both repositories never has to reconcile two different EF Core resolutions. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Realtime">
    <!-- Redis connection is shared with Caching.Redis (3-04) - both register IConnectionMultiplexer
         via TryAddSingleton against the same Redis:ConnectionString key, so whichever project's DI
         wiring runs first wins and the other reuses it. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Resilience">
    <!-- The lean v8 resilience package (ResiliencePipeline), not the full classic-API `Polly`
         package - Ago.Platform.Resilience's builder only ever needs retry/timeout/circuit-breaker/
         rate-limiter strategies, not the v7 Policy<T>/PolicyWrap surface. 3-04 originally kept this
         inline in Ago.Platform.Caching.Redis rather than a shared project ("exactly one caller");
         6-01 revisits that once Ago.Platform.Storage.S3 duplicated the same shape independently and
         extracts Ago.Platform.Resilience for real. Polly.RateLimiting is the v8 family's
         rate-limiter-based bulkhead - Polly.Core alone does not ship one; the classic Polly.Bulkhead
         package targets the v7 API this repo deliberately does not take (6-01's confirmation against
         this pin, not an assumption). Ago.Platform.Caching.Redis and Ago.Platform.Storage.S3 still
         reference Polly.Core directly too, for the ResiliencePipeline type their adapters hold - only
         ResiliencePipelineBuilder construction moves behind this package (arch-tested). -->
    <PackageVersion Include="Polly.Core" Version="8.5.2" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.5.2" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <!-- 5-02: MinIO is S3-API-compatible, so the official AWS SDK is the client, pointed at a
         custom ServiceURL - no MinIO-specific SDK, exactly the "the API is the same, so the
         deployment target stops being an architectural question" reasoning file-storage.md states. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.3" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- `7-01`: the OTel .NET SDK, pinned to its current stable line (1.18.0) across the SDK core,
         the generic-host integration (`AddOpenTelemetry()`), the two instrumentation packages the
         backlog names explicitly (ASP.NET Core, HttpClient - Npgsql needs no package at all, only
         `.AddSource("Npgsql")`, since Npgsql has emitted its own Activities since 6.0), the OTLP
         exporter, and the in-memory exporter used only by tests (this item's own Done-when: prove
         correctness against an in-memory exporter, not a live Jaeger - `7-03`'s job). -->
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <!-- `7-02` fix (found live while verifying `7-03`): metrics were wired as an OTLP push exporter
         sharing `Otel:Exporter:Endpoint` with tracing - which points at Jaeger, and Jaeger does not
         implement the OTLP metrics collector service, so no metric ever actually reached anything.
         Prometheus needs a pull/scrape `/metrics` endpoint instead, which this package provides
         (`.AddPrometheusExporter()` on the MeterProvider builder, `app.MapPrometheusScrapingEndpoint()`
         on each host). Pinned to 1.18.0-beta.1, matching the SDK's own 1.18.0 line - this package has
         never shipped a stable release across its entire history (confirmed against the real NuGet
         flat-container index, not assumed), a known, long-standing characteristic of this specific
         package, not a mistake or a stand-in for a "real" version that will appear later. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
  </ItemGroup>

</Project>
